---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="About Us | MyQRCodeFree"
  description="Learn about MyQRCodeFree - a free, fast, and privacy-focused browser-based QR code generator."
>
  <Header />
  <main class="flex-1 py-10 sm:py-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <!-- Back Link -->
      <div class="mb-8">
        <a
          href="/"
          class="inline-flex items-center gap-1.5 text-sm font-medium text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300 transition-colors"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m15 18-6-6 6-6"></path>
          </svg>
          Back to Generator
        </a>
      </div>

      <article class="rounded-2xl border border-slate-200/80 bg-white p-6 sm:p-10 shadow-xs dark:border-slate-800/80 dark:bg-slate-900/60">
        <header class="border-b border-slate-200/80 pb-6 dark:border-slate-800/80">
          <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
            About Us
          </h1>
          <h2 class="mt-2 text-lg font-medium text-slate-600 dark:text-slate-300">
            About MyQRCodeFree
          </h2>
        </header>

        <div class="mt-8 space-y-6 text-base leading-relaxed text-slate-600 dark:text-slate-300">
          <p>
            MyQRCodeFree is a free, browser-based QR code generator built for speed, privacy, and simplicity. Whether you need a QR code for a website link, WiFi network, contact card, or a location, our tool creates it instantly — no sign-up, no watermarks, no limits.
          </p>

          <p>
            Everything happens directly in your browser. We don't send your data to a server, which means what you type stays with you.
          </p>

          <p>
            We built this tool because most QR generators online are cluttered with unnecessary steps, forced sign-ups, or hidden paywalls. MyQRCodeFree strips that away — just open the site, enter your details, and download your QR code.
          </p>

          <p>
            This tool is part of a small collection of free, no-nonsense web utilities designed to do one job well.
          </p>
        </div>

        <div class="mt-10 rounded-xl bg-blue-50/70 p-6 border border-blue-100 dark:border-blue-900/40 dark:bg-blue-950/30">
          <div class="sm:flex sm:items-center sm:justify-between">
            <div>
              <h3 class="text-base font-semibold text-slate-900 dark:text-white">Ready to create a QR code?</h3>
              <p class="text-sm text-slate-600 dark:text-slate-400 mt-1">Generate high-res PNG or vector SVG codes in seconds.</p>
            </div>
            <a
              href="/"
              class="mt-4 sm:mt-0 inline-flex items-center justify-center rounded-xl bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-blue-700 transition focus:outline-hidden focus:ring-2 focus:ring-blue-500"
            >
              Open Generator
            </a>
          </div>
        </div>
      </article>
    </div>
  </main>
  <Footer />
</Layout>
