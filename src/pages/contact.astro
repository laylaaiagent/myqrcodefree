---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Contact Us | MyQRCodeFree"
  description="Contact MyQRCodeFree support for questions, bug reports, or feature requests."
>
  <Header />
  <main class="flex-1 py-10 sm:py-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <!-- Back Link -->
      <div class="mb-8">
        <a
          href="/"
          class="inline-flex items-center gap-1.5 text-sm font-medium text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300 transition-colors"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m15 18-6-6 6-6"></path>
          </svg>
          Back to Generator
        </a>
      </div>

      <article class="rounded-2xl border border-slate-200/80 bg-white p-6 sm:p-10 shadow-xs dark:border-slate-800/80 dark:bg-slate-900/60">
        <header class="border-b border-slate-200/80 pb-6 dark:border-slate-800/80">
          <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
            Contact Us
          </h1>
        </header>

        <div class="mt-8 space-y-6 text-base leading-relaxed text-slate-600 dark:text-slate-300">
          <p>
            Have a question, found a bug, or have a feature request? We'd love to hear from you.
          </p>

          <div class="rounded-xl border border-slate-200/80 bg-slate-50/80 p-5 dark:border-slate-800 dark:bg-slate-800/50">
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-blue-100 text-blue-600 dark:bg-blue-950 dark:text-blue-400">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                </svg>
              </div>
              <div>
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Email</span>
                <p class="text-base font-medium text-slate-900 dark:text-white">
                  Email: <a href="mailto:support@myqrcodefree.com" class="text-blue-600 underline underline-offset-4 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300">support@myqrcodefree.com</a>
                </p>
              </div>
            </div>
          </div>

          <p>
            We aim to respond within 2–3 business days. Since MyQRCodeFree is a small, independently run tool, please bear with us if it takes a little longer during busy periods.
          </p>
        </div>
      </article>
    </div>
  </main>
  <Footer />
</Layout>
