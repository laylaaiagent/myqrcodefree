<script>
  import QRCode from 'qrcode';

  function initQRGenerator() {
    // State
    let currentTab = 'url';
    let currentLogoImg: HTMLImageElement | null = null;
    let currentLogoDataUrl = '';
    let currentLogoName = '';

    // Elements
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
    const tabPanels = document.querySelectorAll<HTMLElement>('.tab-panel');
    const qrCanvas = document.getElementById('qr-canvas') as HTMLCanvasElement;
    const payloadDisplay = document.getElementById('payload-display') as HTMLElement;
    const payloadLength = document.getElementById('payload-length') as HTMLElement;
    const qrStatusBadge = document.getElementById('qr-status-badge') as HTMLElement;

    // Inputs: URL
    const inputUrl = document.getElementById('input-url') as HTMLInputElement;
    const prefixBtns = document.querySelectorAll<HTMLButtonElement>('.prefix-btn');

    // Inputs: Text
    const inputText = document.getElementById('input-text') as HTMLTextAreaElement;
    const textCounter = document.getElementById('text-counter') as HTMLElement;

    // Inputs: WiFi
    const wifiSsid = document.getElementById('wifi-ssid') as HTMLInputElement;
    const wifiEncryption = document.getElementById('wifi-encryption') as HTMLSelectElement;
    const wifiPassword = document.getElementById('wifi-password') as HTMLInputElement;
    const wifiHidden = document.getElementById('wifi-hidden') as HTMLInputElement;
    const wifiTogglePass = document.getElementById('wifi-toggle-pass') as HTMLButtonElement;
    const wifiPassContainer = document.getElementById('wifi-pass-container') as HTMLElement;

    // Inputs: vCard
    const vcardFn = document.getElementById('vcard-fn') as HTMLInputElement;
    const vcardLn = document.getElementById('vcard-ln') as HTMLInputElement;
    const vcardTel = document.getElementById('vcard-tel') as HTMLInputElement;
    const vcardEmail = document.getElementById('vcard-email') as HTMLInputElement;
    const vcardOrg = document.getElementById('vcard-org') as HTMLInputElement;
    const vcardTitle = document.getElementById('vcard-title') as HTMLInputElement;
    const vcardUrl = document.getElementById('vcard-url') as HTMLInputElement;

    // Inputs: Location
    const geoLat = document.getElementById('geo-lat') as HTMLInputElement;
    const geoLng = document.getElementById('geo-lng') as HTMLInputElement;
    const geoLocateBtn = document.getElementById('geo-locate-btn') as HTMLButtonElement;
    const geoPresets = document.querySelectorAll<HTMLButtonElement>('.geo-preset');
    const geoPreviewText = document.getElementById('geo-preview-text') as HTMLElement;
    const geoMapsLink = document.getElementById('geo-maps-link') as HTMLAnchorElement;

    // Customization: Colors
    const colorFg = document.getElementById('color-fg') as HTMLInputElement;
    const colorFgHex = document.getElementById('color-fg-hex') as HTMLInputElement;
    const colorBg = document.getElementById('color-bg') as HTMLInputElement;
    const colorBgHex = document.getElementById('color-bg-hex') as HTMLInputElement;
    const colorPresets = document.querySelectorAll<HTMLButtonElement>('.color-preset');
    const contrastWarning = document.getElementById('contrast-warning') as HTMLElement;

    // Customization: ECL
    const eclCards = document.querySelectorAll<HTMLElement>('.ecl-card');
    const eclHint = document.getElementById('ecl-hint') as HTMLElement;

    // Customization: Logo
    const logoInput = document.getElementById('logo-input') as HTMLInputElement;
    const logoDropzone = document.getElementById('logo-dropzone') as HTMLElement;
    const logoActiveContainer = document.getElementById('logo-active-container') as HTMLElement;
    const logoPreviewThumb = document.getElementById('logo-preview-thumb') as HTMLImageElement;
    const logoFileName = document.getElementById('logo-file-name') as HTMLElement;
    const logoRemoveBtn = document.getElementById('logo-remove-btn') as HTMLButtonElement;
    const logoSizeRange = document.getElementById('logo-size-range') as HTMLInputElement;
    const logoSizeVal = document.getElementById('logo-size-val') as HTMLElement;
    const logoBgBadge = document.getElementById('logo-bg-badge') as HTMLInputElement;

    // Actions
    const downloadPngBtn = document.getElementById('download-png-btn') as HTMLButtonElement;
    const downloadSvgBtn = document.getElementById('download-svg-btn') as HTMLButtonElement;
    const copyImageBtn = document.getElementById('copy-image-btn') as HTMLButtonElement;
    const copyIcon = document.getElementById('copy-icon') as HTMLElement;
    const copyText = document.getElementById('copy-text') as HTMLElement;

    // Helper: Escape WiFi Special Characters (\ ; , : ")
    function escapeWifi(str: string): string {
      return str.replace(/([\\;,:"'])/g, '\\$1');
    }

    // Calculate Payload based on Active Tab
    function getPayload(): string {
      switch (currentTab) {
        case 'url': {
          let url = (inputUrl?.value || '').trim();
          if (!url) return 'https://myqrcodefree.com';
          // If user didn't type a scheme and it looks like a domain, prepend https://
          if (!/^https?:\/\//i.test(url) && !url.includes(':')) {
            url = 'https://' + url;
          }
          return url;
        }

        case 'text': {
          const text = inputText?.value || '';
          return text.trim() ? text : 'Free QR Code Generator';
        }

        case 'wifi': {
          const ssid = (wifiSsid?.value || '').trim();
          const auth = wifiEncryption?.value || 'WPA';
          const pass = wifiPassword?.value || '';
          const hidden = wifiHidden?.checked || false;

          if (!ssid) return 'WIFI:S:MyWiFi;T:WPA;P:password;;';

          // Format: WIFI:T:WPA;S:MySSID;P:MyPassword;H:false;;
          let wifiStr = `WIFI:T:${auth};S:${escapeWifi(ssid)};`;
          if (auth !== 'nopass' && pass) {
            wifiStr += `P:${escapeWifi(pass)};`;
          }
          if (hidden) {
            wifiStr += `H:true;`;
          }
          wifiStr += ';';
          return wifiStr;
        }

        case 'vcard': {
          const fn = (vcardFn?.value || '').trim();
          const ln = (vcardLn?.value || '').trim();
          const tel = (vcardTel?.value || '').trim();
          const email = (vcardEmail?.value || '').trim();
          const org = (vcardOrg?.value || '').trim();
          const title = (vcardTitle?.value || '').trim();
          const url = (vcardUrl?.value || '').trim();

          const fullName = [fn, ln].filter(Boolean).join(' ') || 'John Doe';

          let vcard = 'BEGIN:VCARD\nVERSION:3.0\n';
          vcard += `N:${ln};${fn};;;\n`;
          vcard += `FN:${fullName}\n`;
          if (org) vcard += `ORG:${org}\n`;
          if (title) vcard += `TITLE:${title}\n`;
          if (tel) vcard += `TEL;TYPE=CELL:${tel}\n`;
          if (email) vcard += `EMAIL:${email}\n`;
          if (url) vcard += `URL:${url}\n`;
          vcard += 'END:VCARD';
          return vcard;
        }

        case 'location': {
          let lat = parseFloat(geoLat?.value || '0');
          let lng = parseFloat(geoLng?.value || '0');
          if (isNaN(lat)) lat = 37.7749;
          if (isNaN(lng)) lng = -122.4194;

          // Update geo display & map link
          const geoStr = `geo:${lat},${lng}`;
          if (geoPreviewText) geoPreviewText.textContent = geoStr;
          if (geoMapsLink) geoMapsLink.href = `https://maps.google.com/?q=${lat},${lng}`;

          return geoStr;
        }

        default:
          return 'https://myqrcodefree.com';
      }
    }

    // Get selected Error Correction Level
    function getECL(): 'L' | 'M' | 'Q' | 'H' {
      const selected = document.querySelector<HTMLInputElement>('input[name="ecl"]:checked');
      return (selected?.value as 'L' | 'M' | 'Q' | 'H') || 'M';
    }

    // Check contrast between two hex colors
    function checkContrast(hex1: string, hex2: string) {
      function getLuminance(hex: string) {
        const clean = hex.replace('#', '');
        const r = parseInt(clean.substring(0, 2), 16) / 255;
        const g = parseInt(clean.substring(2, 4), 16) / 255;
        const b = parseInt(clean.substring(4, 6), 16) / 255;
        const a = [r, g, b].map((v) => (v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4)));
        return 0.2126 * a[0] + 0.7152 * a[1] + 0.0722 * a[2];
      }
      try {
        const l1 = getLuminance(hex1);
        const l2 = getLuminance(hex2);
        const ratio = (Math.max(l1, l2) + 0.05) / (Math.min(l1, l2) + 0.05);
        if (ratio < 2.5) {
          contrastWarning?.classList.remove('hidden');
        } else {
          contrastWarning?.classList.add('hidden');
        }
      } catch (_) {
        contrastWarning?.classList.add('hidden');
      }
    }

    // Draw logo overlay onto canvas
    function drawLogoOnCanvas(canvas: HTMLCanvasElement, img: HTMLImageElement, sizePercent: number, bgBadge: boolean, bgColor: string) {
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const size = canvas.width * (sizePercent / 100);
      const x = (canvas.width - size) / 2;
      const y = (canvas.height - size) / 2;

      const drawRounded = (bx: number, by: number, bw: number, bh: number, br: number) => {
        if (typeof (ctx as any).roundRect === 'function') {
          (ctx as any).roundRect(bx, by, bw, bh, br);
        } else {
          ctx.rect(bx, by, bw, bh);
        }
      };

      if (bgBadge) {
        const padding = size * 0.12;
        const badgeSize = size + padding * 2;
        const badgeX = x - padding;
        const badgeY = y - padding;
        const radius = badgeSize * 0.18;

        ctx.save();
        ctx.fillStyle = bgColor || '#ffffff';
        ctx.beginPath();
        drawRounded(badgeX, badgeY, badgeSize, badgeSize, radius);
        ctx.fill();
        // Subtle outline for definition
        ctx.strokeStyle = 'rgba(0,0,0,0.06)';
        ctx.lineWidth = 1;
        ctx.stroke();
        ctx.restore();
      }

      ctx.save();
      // Clip rounded corners for logo
      const logoRadius = size * 0.12;
      ctx.beginPath();
      drawRounded(x, y, size, size, logoRadius);
      ctx.clip();
      ctx.drawImage(img, x, y, size, size);
      ctx.restore();
    }

    // Render QR Code (Live update)
    let renderDebounceTimer: number | undefined;
    function renderQRCode() {
      clearTimeout(renderDebounceTimer);
      renderDebounceTimer = window.setTimeout(async () => {
        try {
          const payload = getPayload();
          const ecl = getECL();
          const fg = colorFg?.value || '#000000';
          const bg = colorBg?.value || '#ffffff';
          const logoSize = parseInt(logoSizeRange?.value || '22', 10);
          const bgBadge = logoBgBadge?.checked ?? true;

          // Update payload indicator
          if (payloadDisplay) payloadDisplay.textContent = payload;
          if (payloadLength) payloadLength.textContent = `${payload.length} chars`;

          checkContrast(fg, bg);

          // Render onto preview canvas
          const previewSize = 300;
          await QRCode.toCanvas(qrCanvas, payload, {
            width: previewSize,
            margin: 2,
            errorCorrectionLevel: ecl,
            color: {
              dark: fg,
              light: bg,
            },
          });

          // Draw logo if uploaded
          if (currentLogoImg) {
            drawLogoOnCanvas(qrCanvas, currentLogoImg, logoSize, bgBadge, bg);
          }

          if (qrStatusBadge) {
            qrStatusBadge.textContent = 'Ready to scan';
            qrStatusBadge.className = 'rounded-full bg-emerald-50 px-2.5 py-0.5 text-[11px] font-semibold text-emerald-700 ring-1 ring-inset ring-emerald-600/20 dark:bg-emerald-950/40 dark:text-emerald-400';
          }
        } catch (err: any) {
          console.error('QR Code render error:', err);
          if (qrStatusBadge) {
            qrStatusBadge.textContent = 'Data too long for chosen level';
            qrStatusBadge.className = 'rounded-full bg-red-50 px-2.5 py-0.5 text-[11px] font-semibold text-red-700 ring-1 ring-inset ring-red-600/20 dark:bg-red-950/40 dark:text-red-400';
          }
        }
      }, 50);
    }

    // High-Resolution PNG Generator for Download
    async function generateHighResCanvas(): Promise<HTMLCanvasElement> {
      const payload = getPayload();
      const ecl = getECL();
      const fg = colorFg?.value || '#000000';
      const bg = colorBg?.value || '#ffffff';
      const logoSize = parseInt(logoSizeRange?.value || '22', 10);
      const bgBadge = logoBgBadge?.checked ?? true;

      const offscreen = document.createElement('canvas');
      const targetSize = 1200; // Crisp high-res for print

      await QRCode.toCanvas(offscreen, payload, {
        width: targetSize,
        margin: 2,
        errorCorrectionLevel: ecl,
        color: {
          dark: fg,
          light: bg,
        },
      });

      if (currentLogoImg) {
        drawLogoOnCanvas(offscreen, currentLogoImg, logoSize, bgBadge, bg);
      }

      return offscreen;
    }

    // Generate SVG string (including embedded logo if present)
    async function generateSVGString(): Promise<string> {
      const payload = getPayload();
      const ecl = getECL();
      const fg = colorFg?.value || '#000000';
      const bg = colorBg?.value || '#ffffff';
      const logoSize = parseInt(logoSizeRange?.value || '22', 10);
      const bgBadge = logoBgBadge?.checked ?? true;

      let svgString = await QRCode.toString(payload, {
        type: 'svg',
        margin: 2,
        errorCorrectionLevel: ecl,
        color: {
          dark: fg,
          light: bg,
        },
      });

      // Embed logo if available
      if (currentLogoDataUrl) {
        // Extract viewBox or dimension from SVG
        const viewBoxMatch = svgString.match(/viewBox="0 0 (\d+) (\d+)"/);
        if (viewBoxMatch) {
          const totalWidth = parseFloat(viewBoxMatch[1]);
          const totalHeight = parseFloat(viewBoxMatch[2]);
          const size = totalWidth * (logoSize / 100);
          const x = (totalWidth - size) / 2;
          const y = (totalHeight - size) / 2;
          const padding = size * 0.12;
          const badgeSize = size + padding * 2;
          const badgeX = x - padding;
          const badgeY = y - padding;
          const radius = badgeSize * 0.18;

          let overlay = '';
          if (bgBadge) {
            overlay += `<rect x="${badgeX.toFixed(2)}" y="${badgeY.toFixed(2)}" width="${badgeSize.toFixed(2)}" height="${badgeSize.toFixed(2)}" rx="${radius.toFixed(2)}" fill="${bg}" stroke="rgba(0,0,0,0.06)" stroke-width="0.5"/>`;
          }
          overlay += `<image href="${currentLogoDataUrl}" x="${x.toFixed(2)}" y="${y.toFixed(2)}" width="${size.toFixed(2)}" height="${size.toFixed(2)}" preserveAspectRatio="xMidYMid meet" clip-path="inset(0% round ${radius * 0.6}px)"/>`;

          // Insert overlay before closing </svg>
          svgString = svgString.replace('</svg>', `${overlay}</svg>`);
        }
      }

      return svgString;
    }

    // --- TAB SWITCHING ---
    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.dataset.tab;
        if (!target) return;
        currentTab = target;

        tabButtons.forEach((b) => {
          const isActive = b === btn;
          b.classList.toggle('active', isActive);
          b.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

        tabPanels.forEach((panel) => {
          if (panel.id === `panel-${target}`) {
            panel.classList.remove('hidden');
          } else {
            panel.classList.add('hidden');
          }
        });

        renderQRCode();
      });
    });

    // --- INPUT EVENT LISTENERS ---
    // URL
    inputUrl?.addEventListener('input', renderQRCode);
    prefixBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const prefix = btn.dataset.prefix || '';
        let current = inputUrl.value.trim();
        // Replace existing common prefixes
        current = current.replace(/^(https?:\/\/|mailto:|tel:)/i, '');
        inputUrl.value = prefix + current;
        inputUrl.focus();
        renderQRCode();
      });
    });

    // Text
    inputText?.addEventListener('input', () => {
      if (textCounter) {
        textCounter.textContent = `${inputText.value.length} characters`;
      }
      renderQRCode();
    });

    // WiFi
    wifiSsid?.addEventListener('input', renderQRCode);
    wifiPassword?.addEventListener('input', renderQRCode);
    wifiHidden?.addEventListener('change', renderQRCode);
    wifiEncryption?.addEventListener('change', () => {
      const isNone = wifiEncryption.value === 'nopass';
      if (wifiPassContainer) {
        wifiPassContainer.style.display = isNone ? 'none' : 'block';
      }
      renderQRCode();
    });
    wifiTogglePass?.addEventListener('click', () => {
      const isPass = wifiPassword.type === 'password';
      wifiPassword.type = isPass ? 'text' : 'password';
      wifiTogglePass.textContent = isPass ? 'Hide' : 'Show';
    });

    // vCard
    [vcardFn, vcardLn, vcardTel, vcardEmail, vcardOrg, vcardTitle, vcardUrl].forEach((inp) => {
      inp?.addEventListener('input', renderQRCode);
    });

    // Location
    geoLat?.addEventListener('input', renderQRCode);
    geoLng?.addEventListener('input', renderQRCode);

    geoPresets.forEach((btn) => {
      btn.addEventListener('click', () => {
        const lat = btn.dataset.lat || '0';
        const lng = btn.dataset.lng || '0';
        if (geoLat) geoLat.value = lat;
        if (geoLng) geoLng.value = lng;
        renderQRCode();
      });
    });

    geoLocateBtn?.addEventListener('click', () => {
      if (!navigator.geolocation) {
        alert('Geolocation is not supported by your browser.');
        return;
      }
      geoLocateBtn.disabled = true;
      const originalHtml = geoLocateBtn.innerHTML;
      geoLocateBtn.innerHTML = `<span>Locating...</span>`;

      navigator.geolocation.getCurrentPosition(
        (pos) => {
          const lat = pos.coords.latitude.toFixed(6);
          const lng = pos.coords.longitude.toFixed(6);
          if (geoLat) geoLat.value = lat;
          if (geoLng) geoLng.value = lng;
          geoLocateBtn.disabled = false;
          geoLocateBtn.innerHTML = originalHtml;
          renderQRCode();
        },
        (err) => {
          geoLocateBtn.disabled = false;
          geoLocateBtn.innerHTML = originalHtml;
          alert('Could not retrieve location: ' + err.message);
        },
        { enableHighAccuracy: true, timeout: 10000 }
      );
    });

    // --- COLOR PICKERS ---
    function syncColors(fg: string, bg: string) {
      if (colorFg) colorFg.value = fg;
      if (colorFgHex) colorFgHex.value = fg;
      if (colorBg) colorBg.value = bg;
      if (colorBgHex) colorBgHex.value = bg;
      renderQRCode();
    }

    colorFg?.addEventListener('input', () => {
      if (colorFgHex) colorFgHex.value = colorFg.value;
      renderQRCode();
    });
    colorFgHex?.addEventListener('input', () => {
      if (/^#[0-9A-Fa-f]{6}$/.test(colorFgHex.value)) {
        if (colorFg) colorFg.value = colorFgHex.value;
        renderQRCode();
      }
    });

    colorBg?.addEventListener('input', () => {
      if (colorBgHex) colorBgHex.value = colorBg.value;
      renderQRCode();
    });
    colorBgHex?.addEventListener('input', () => {
      if (/^#[0-9A-Fa-f]{6}$/.test(colorBgHex.value)) {
        if (colorBg) colorBg.value = colorBgHex.value;
        renderQRCode();
      }
    });

    colorPresets.forEach((preset) => {
      preset.addEventListener('click', () => {
        const fg = preset.dataset.fg || '#000000';
        const bg = preset.dataset.bg || '#ffffff';
        syncColors(fg, bg);
      });
    });

    // --- ERROR CORRECTION LEVEL ---
    eclCards.forEach((card) => {
      card.addEventListener('click', () => {
        const radio = card.querySelector<HTMLInputElement>('input[type="radio"]');
        if (radio) {
          radio.checked = true;
          updateECLUI();
          renderQRCode();
        }
      });
    });

    function setECL(level: 'L' | 'M' | 'Q' | 'H') {
      const radio = document.querySelector<HTMLInputElement>(`input[name="ecl"][value="${level}"]`);
      if (radio) {
        radio.checked = true;
        updateECLUI();
        renderQRCode();
      }
    }

    function updateECLUI() {
      const current = getECL();
      eclCards.forEach((c) => {
        const r = c.querySelector<HTMLInputElement>('input[type="radio"]');
        const isActive = r?.value === current;
        c.classList.toggle('border-blue-500', isActive);
        c.classList.toggle('bg-blue-50/50', isActive);
        c.classList.toggle('dark:border-blue-500', isActive);
        c.classList.toggle('dark:bg-blue-950/30', isActive);
      });

      const hints: Record<string, string> = {
        L: 'Low redundancy (7%) • Clearest / least dense',
        M: 'Standard redundancy (15%) • Recommended default',
        Q: 'Quartile redundancy (25%) • High scannability',
        H: 'High redundancy (30%) • Recommended for logo overlay',
      };
      if (eclHint) eclHint.textContent = hints[current] || '';
    }

    // --- LOGO UPLOAD & HANDLING ---
    function handleLogoFile(file: File) {
      if (!file.type.startsWith('image/')) {
        alert('Please upload a valid image file (PNG, JPG, SVG, WebP).');
        return;
      }

      const reader = new FileReader();
      reader.onload = (e) => {
        const dataUrl = e.target?.result as string;
        currentLogoDataUrl = dataUrl;
        currentLogoName = file.name;

        const img = new Image();
        img.onload = () => {
          currentLogoImg = img;
          if (logoPreviewThumb) logoPreviewThumb.src = dataUrl;
          if (logoFileName) logoFileName.textContent = file.name;
          logoDropzone?.classList.add('hidden');
          logoActiveContainer?.classList.remove('hidden');

          // Recommend and automatically boost Error Correction Level to 'H'
          setECL('H');
          renderQRCode();
        };
        img.src = dataUrl;
      };
      reader.readAsDataURL(file);
    }

    logoInput?.addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (file) handleLogoFile(file);
    });

    logoRemoveBtn?.addEventListener('click', () => {
      currentLogoImg = null;
      currentLogoDataUrl = '';
      currentLogoName = '';
      if (logoInput) logoInput.value = '';
      logoActiveContainer?.classList.add('hidden');
      logoDropzone?.classList.remove('hidden');
      renderQRCode();
    });

    logoSizeRange?.addEventListener('input', () => {
      if (logoSizeVal) logoSizeVal.textContent = `${logoSizeRange.value}%`;
      renderQRCode();
    });

    logoBgBadge?.addEventListener('change', renderQRCode);

    // --- DOWNLOAD ACTIONS ---
    downloadPngBtn?.addEventListener('click', async () => {
      try {
        downloadPngBtn.disabled = true;
        const origText = downloadPngBtn.querySelector('span')?.textContent || 'Download PNG';
        const span = downloadPngBtn.querySelector('span');
        if (span) span.textContent = 'Generating 1200px...';

        const highRes = await generateHighResCanvas();
        const link = document.createElement('a');
        link.download = `qrcode-${currentTab}-${Date.now()}.png`;
        link.href = highRes.toDataURL('image/png');
        link.click();

        if (span) span.textContent = origText;
        downloadPngBtn.disabled = false;
      } catch (err) {
        console.error('PNG download error:', err);
        downloadPngBtn.disabled = false;
      }
    });

    downloadSvgBtn?.addEventListener('click', async () => {
      try {
        downloadSvgBtn.disabled = true;
        const svgStr = await generateSVGString();
        const blob = new Blob([svgStr], { type: 'image/svg+xml;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.download = `qrcode-${currentTab}-${Date.now()}.svg`;
        link.href = url;
        link.click();
        URL.revokeObjectURL(url);
        downloadSvgBtn.disabled = false;
      } catch (err) {
        console.error('SVG download error:', err);
        downloadSvgBtn.disabled = false;
      }
    });

    // Copy PNG to Clipboard
    copyImageBtn?.addEventListener('click', async () => {
      try {
        const highRes = await generateHighResCanvas();
        highRes.toBlob(async (blob) => {
          if (!blob) return;
          try {
            await navigator.clipboard.write([
              new ClipboardItem({ 'image/png': blob })
            ]);
            if (copyText) copyText.textContent = 'Copied to Clipboard! ✓';
            setTimeout(() => {
              if (copyText) copyText.textContent = 'Copy Image to Clipboard';
            }, 2000);
          } catch (e) {
            // Fallback: Copy URL text or notify
            const payload = getPayload();
            await navigator.clipboard.writeText(payload);
            if (copyText) copyText.textContent = 'Copied Payload Text! ✓';
            setTimeout(() => {
              if (copyText) copyText.textContent = 'Copy Image to Clipboard';
            }, 2000);
          }
        }, 'image/png');
      } catch (err) {
        console.error('Copy to clipboard failed:', err);
      }
    });

    // Initial render
    renderQRCode();
  }

  // Setup on page load
  initQRGenerator();
  document.addEventListener('astro:page-load', initQRGenerator);
</script>
