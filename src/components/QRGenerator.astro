---
import AdPlaceholder from './AdPlaceholder.astro';
---

<div id="generator" class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <!-- Top Ad Placeholder -->
  <div class="flex justify-center">
    <AdPlaceholder slotType="top" className="w-full" />
  </div>

  <!-- Hero Header -->
  <div class="my-6 text-center">
    <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50/70 px-3 py-1 text-xs font-semibold text-blue-700 shadow-xs dark:border-blue-900/50 dark:bg-blue-950/40 dark:text-blue-300">
      <span class="flex h-1.5 w-1.5 rounded-full bg-blue-600 dark:bg-blue-400 animate-ping"></span>
      Instant Client-Side QR Generator • No Limits
    </div>
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl dark:text-white">
      Free QR Code Generator
    </h1>
    <p class="mx-auto mt-3 max-w-2xl text-base text-slate-600 sm:text-lg dark:text-slate-400">
      Create customizable QR codes for links, Wi-Fi networks, contacts, text, and GPS locations with custom colors and logo overlay.
    </p>
  </div>

  <!-- Main Generator Grid: Inputs (Left) & Sticky Preview (Right) & Sidebar Ad -->
  <div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-12 items-start">
    
    <!-- LEFT COLUMN: Generator Controls (7 cols) -->
    <div class="space-y-6 lg:col-span-7">
      
      <!-- Type Selector Tabs -->
      <div class="rounded-2xl border border-slate-200 bg-white p-2 shadow-xs transition-colors dark:border-slate-800 dark:bg-slate-900">
        <div class="grid grid-cols-3 gap-1.5 sm:grid-cols-5" role="tablist" aria-label="QR Code Type">
          <button
            type="button"
            class="tab-btn active inline-flex flex-col sm:flex-row items-center justify-center gap-1.5 rounded-xl px-3 py-2.5 text-xs sm:text-sm font-semibold transition-all duration-150"
            data-tab="url"
            role="tab"
            aria-selected="true"
            aria-controls="panel-url"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
            <span>URL</span>
          </button>

          <button
            type="button"
            class="tab-btn inline-flex flex-col sm:flex-row items-center justify-center gap-1.5 rounded-xl px-3 py-2.5 text-xs sm:text-sm font-semibold transition-all duration-150"
            data-tab="text"
            role="tab"
            aria-selected="false"
            aria-controls="panel-text"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
            <span>Text</span>
          </button>

          <button
            type="button"
            class="tab-btn inline-flex flex-col sm:flex-row items-center justify-center gap-1.5 rounded-xl px-3 py-2.5 text-xs sm:text-sm font-semibold transition-all duration-150"
            data-tab="wifi"
            role="tab"
            aria-selected="false"
            aria-controls="panel-wifi"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12.55a11 11 0 0 1 14.08 0"></path>
              <path d="M1.42 9a16 16 0 0 1 21.16 0"></path>
              <path d="M8.53 16.11a6 6 0 0 1 6.95 0"></path>
              <line x1="12" y1="20" x2="12.01" y2="20"></line>
            </svg>
            <span>WiFi</span>
          </button>

          <button
            type="button"
            class="tab-btn inline-flex flex-col sm:flex-row items-center justify-center gap-1.5 rounded-xl px-3 py-2.5 text-xs sm:text-sm font-semibold transition-all duration-150"
            data-tab="vcard"
            role="tab"
            aria-selected="false"
            aria-controls="panel-vcard"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
            <span>vCard</span>
          </button>

          <button
            type="button"
            class="tab-btn inline-flex flex-col sm:flex-row items-center justify-center gap-1.5 rounded-xl px-3 py-2.5 text-xs sm:text-sm font-semibold transition-all duration-150"
            data-tab="location"
            role="tab"
            aria-selected="false"
            aria-controls="panel-location"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>Location</span>
          </button>
        </div>
      </div>

      <!-- Content Panels -->
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xs transition-colors dark:border-slate-800 dark:bg-slate-900">
        
        <!-- URL Panel -->
        <div id="panel-url" class="tab-panel space-y-4">
          <div>
            <label for="input-url" class="block text-sm font-semibold text-slate-800 dark:text-slate-200">
              Website URL
            </label>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
              Enter any web page, link, social profile, or document link.
            </p>
            <div class="relative mt-2">
              <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400 dark:text-slate-500">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                  <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                </svg>
              </div>
              <input
                type="url"
                id="input-url"
                class="w-full rounded-xl border border-slate-300 bg-slate-50/50 py-2.5 pl-10 pr-4 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-500 focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-800/50 dark:text-white dark:focus:bg-slate-900"
                placeholder="https://example.com"
                value="https://myqrcodefree.com"
              />
            </div>
          </div>
          <!-- Quick protocol prefixes -->
          <div class="flex flex-wrap items-center gap-2 pt-1 text-xs text-slate-500 dark:text-slate-400">
            <span>Quick prefix:</span>
            <button type="button" class="prefix-btn rounded-md border border-slate-200 bg-slate-100 px-2 py-1 font-mono text-[11px] hover:bg-slate-200 dark:border-slate-700 dark:bg-slate-800 dark:hover:bg-slate-700" data-prefix="https://">https://</button>
            <button type="button" class="prefix-btn rounded-md border border-slate-200 bg-slate-100 px-2 py-1 font-mono text-[11px] hover:bg-slate-200 dark:border-slate-700 dark:bg-slate-800 dark:hover:bg-slate-700" data-prefix="http://">http://</button>
            <button type="button" class="prefix-btn rounded-md border border-slate-200 bg-slate-100 px-2 py-1 font-mono text-[11px] hover:bg-slate-200 dark:border-slate-700 dark:bg-slate-800 dark:hover:bg-slate-700" data-prefix="mailto:">mailto:</button>
            <button type="button" class="prefix-btn rounded-md border border-slate-200 bg-slate-100 px-2 py-1 font-mono text-[11px] hover:bg-slate-200 dark:border-slate-700 dark:bg-slate-800 dark:hover:bg-slate-700" data-prefix="tel:">tel:</button>
          </div>
        </div>

        <!-- Text Panel -->
        <div id="panel-text" class="tab-panel hidden space-y-4">
          <div>
            <div class="flex items-center justify-between">
              <label for="input-text" class="block text-sm font-semibold text-slate-800 dark:text-slate-200">
                Plain Text Message
              </label>
              <span id="text-counter" class="text-xs text-slate-400">0 characters</span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
              Enter any plain text, notes, instructions, or promo codes.
            </p>
            <textarea
              id="input-text"
              rows="4"
              class="mt-2 w-full rounded-xl border border-slate-300 bg-slate-50/50 p-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-500 focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-800/50 dark:text-white dark:focus:bg-slate-900"
              placeholder="Type or paste any text here..."
            ></textarea>
          </div>
        </div>

        <!-- WiFi Panel -->
        <div id="panel-wifi" class="tab-panel hidden space-y-4">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div class="sm:col-span-2">
              <label for="wifi-ssid" class="block text-sm font-semibold text-slate-800 dark:text-slate-200">
                Network Name (SSID) *
              </label>
              <input
                type="text"
                id="wifi-ssid"
                class="mt-1.5 w-full rounded-xl border border-slate-300 bg-slate-50/50 px-3.5 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-500 focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-800/50 dark:text-white dark:focus:bg-slate-900"
                placeholder="e.g. Guest-WiFi"
              />
            </div>

            <div>
              <label for="wifi-encryption" class="block text-sm font-semibold text-slate-800 dark:text-slate-200">
                Security / Encryption
              </label>
              <select
                id="wifi-encryption"
                class="mt-1.5 w-full rounded-xl border border-slate-300 bg-slate-50/50 px-3.5 py-2.5 text-sm text-slate-900 focus:border-blue-500 focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-800/50 dark:text-white dark:focus:bg-slate-900"
              >
                <option value="WPA" selected>WPA / WPA2 / WPA3 (Standard)</option>
                <option value="WEP">WEP (Older)</option>
                <option value="nopass">No Password (Open Network)</option>
              </select>
            </div>

            <div id="wifi-pass-container">
              <div class="flex items-center justify-between">
                <label for="wifi-password" class="block text-sm font-semibold text-slate-800 dark:text-slate-200">
                  Password
                </label>
                <button type="button" id="wifi-toggle-pass" class="text-xs text-blue-600 dark:text-blue-400 hover:underline">
                  Show
                </button>
              </div>
              <input
                type="password"
                id="wifi-password"
                class="mt-1.5 w-full rounded-xl border border-slate-300 bg-slate-50/50 px-3.5 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-500 focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-800/50 dark:text-white dark:focus:bg-slate-900"
                placeholder="Wi-Fi password"
              />
            </div>

            <div class="sm:col-span-2">
              <label class="inline-flex items-center gap-2 cursor-pointer">
                <input
                  type="checkbox"
                  id="wifi-hidden"
                  class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-800"
                />
                <span class="text-xs font-medium text-slate-700 dark:text-slate-300">
                  Hidden network (SSID is not broadcast)
                </span>
              </label>
            </div>
          </div>
        </div>

        <!-- vCard Panel -->
        <div id="panel-vcard" class="tab-panel hidden space-y-4">
          <div class="grid grid-cols-1 gap-3.5 sm:grid-cols-2">
            <div>
              <label for="vcard-fn" class="block text-xs font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-400">
                First Name *
              </label>
              <input
                type="text"
                id="vcard-fn"
                class="mt-1 w-full rounded-xl border border-slate-300 bg-slate-50/50 px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-500 focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-800/50 dark:text-white dark:focus:bg-slate-900"
                placeholder="John"
              />
            </div>
            <div>
              <label for="vcard-ln" class="block text-xs font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-400">
                Last Name
              </label>
              <input
                type="text"
                id="vcard-ln"
                class="mt-1 w-full rounded-xl border border-slate-300 bg-slate-50/50 px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-500 focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-800/50 dark:text-white dark:focus:bg-slate-900"
                placeholder="Doe"
              />
            </div>
            <div>
              <label for="vcard-tel" class="block text-xs font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-400">
                Phone Number
              </label>
              <input
                type="tel"
                id="vcard-tel"
                class="mt-1 w-full rounded-xl border border-slate-300 bg-slate-50/50 px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-500 focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-800/50 dark:text-white dark:focus:bg-slate-900"
                placeholder="+1 (555) 000-0000"
              />
            </div>
            <div>
              <label for="vcard-email" class="block text-xs font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-400">
                Email Address
              </label>
              <input
                type="email"
                id="vcard-email"
                class="mt-1 w-full rounded-xl border border-slate-300 bg-slate-50/50 px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-500 focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-800/50 dark:text-white dark:focus:bg-slate-900"
                placeholder="john@example.com"
              />
            </div>
            <div>
              <label for="vcard-org" class="block text-xs font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-400">
                Company / Organization
              </label>
              <input
                type="text"
                id="vcard-org"
                class="mt-1 w-full rounded-xl border border-slate-300 bg-slate-50/50 px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-500 focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-800/50 dark:text-white dark:focus:bg-slate-900"
                placeholder="Acme Corp"
              />
            </div>
            <div>
              <label for="vcard-title" class="block text-xs font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-400">
                Job Title
              </label>
              <input
                type="text"
                id="vcard-title"
                class="mt-1 w-full rounded-xl border border-slate-300 bg-slate-50/50 px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-500 focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-800/50 dark:text-white dark:focus:bg-slate-900"
                placeholder="Product Designer"
              />
            </div>
            <div class="sm:col-span-2">
              <label for="vcard-url" class="block text-xs font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-400">
                Website
              </label>
              <input
                type="url"
                id="vcard-url"
                class="mt-1 w-full rounded-xl border border-slate-300 bg-slate-50/50 px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-500 focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-800/50 dark:text-white dark:focus:bg-slate-900"
                placeholder="https://johndoe.com"
              />
            </div>
          </div>
        </div>

        <!-- Location Panel -->
        <div id="panel-location" class="tab-panel hidden space-y-4">
          <div class="flex items-center justify-between">
            <div>
              <h3 class="text-sm font-semibold text-slate-800 dark:text-slate-200">
                Geographic Coordinates
              </h3>
              <p class="text-xs text-slate-500 dark:text-slate-400">
                Generates a standard <code class="rounded bg-slate-100 px-1 py-0.5 text-blue-600 dark:bg-slate-800 dark:text-blue-400">geo:</code> URI QR code recognized by phone navigation apps.
              </p>
            </div>
            <button
              type="button"
              id="geo-locate-btn"
              class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-2xs hover:bg-slate-100 focus:outline-hidden dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
            >
              <svg class="h-3.5 w-3.5 text-blue-600 dark:text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="22" y1="12" x2="18" y2="12"></line>
                <line x1="6" y1="12" x2="2" y2="12"></line>
                <line x1="12" y1="6" x2="12" y2="2"></line>
                <line x1="12" y1="22" x2="12" y2="18"></line>
              </svg>
              <span>Current GPS</span>
            </button>
          </div>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label for="geo-lat" class="block text-xs font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-400">
                Latitude (-90 to 90) *
              </label>
              <input
                type="number"
                id="geo-lat"
                step="any"
                min="-90"
                max="90"
                class="mt-1.5 w-full rounded-xl border border-slate-300 bg-slate-50/50 px-3.5 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-500 focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-800/50 dark:text-white dark:focus:bg-slate-900"
                placeholder="e.g. 37.774929"
                value="37.7749"
              />
            </div>
            <div>
              <label for="geo-lng" class="block text-xs font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-400">
                Longitude (-180 to 180) *
              </label>
              <input
                type="number"
                id="geo-lng"
                step="any"
                min="-180"
                max="180"
                class="mt-1.5 w-full rounded-xl border border-slate-300 bg-slate-50/50 px-3.5 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-500 focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-800/50 dark:text-white dark:focus:bg-slate-900"
                placeholder="e.g. -122.419416"
                value="-122.4194"
              />
            </div>
          </div>

          <!-- Quick Location Presets -->
          <div class="flex flex-wrap items-center gap-1.5 pt-1 text-xs text-slate-500 dark:text-slate-400">
            <span>City presets:</span>
            <button type="button" class="geo-preset rounded-md border border-slate-200 bg-slate-100 px-2 py-0.5 text-[11px] hover:bg-slate-200 dark:border-slate-700 dark:bg-slate-800 dark:hover:bg-slate-700" data-lat="40.7128" data-lng="-74.0060">New York</button>
            <button type="button" class="geo-preset rounded-md border border-slate-200 bg-slate-100 px-2 py-0.5 text-[11px] hover:bg-slate-200 dark:border-slate-700 dark:bg-slate-800 dark:hover:bg-slate-700" data-lat="51.5074" data-lng="-0.1278">London</button>
            <button type="button" class="geo-preset rounded-md border border-slate-200 bg-slate-100 px-2 py-0.5 text-[11px] hover:bg-slate-200 dark:border-slate-700 dark:bg-slate-800 dark:hover:bg-slate-700" data-lat="35.6762" data-lng="139.6503">Tokyo</button>
            <button type="button" class="geo-preset rounded-md border border-slate-200 bg-slate-100 px-2 py-0.5 text-[11px] hover:bg-slate-200 dark:border-slate-700 dark:bg-slate-800 dark:hover:bg-slate-700" data-lat="48.8566" data-lng="2.3522">Paris</button>
            <button type="button" class="geo-preset rounded-md border border-slate-200 bg-slate-100 px-2 py-0.5 text-[11px] hover:bg-slate-200 dark:border-slate-700 dark:bg-slate-800 dark:hover:bg-slate-700" data-lat="37.7749" data-lng="-122.4194">San Francisco</button>
          </div>

          <!-- Live geo URI preview badge -->
          <div class="rounded-xl border border-slate-200/80 bg-slate-50/70 p-3 text-xs dark:border-slate-800 dark:bg-slate-800/40">
            <div class="flex items-center justify-between">
              <span class="font-mono text-slate-600 dark:text-slate-300" id="geo-preview-text">geo:37.7749,-122.4194</span>
              <a id="geo-maps-link" href="https://maps.google.com/?q=37.7749,-122.4194" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:underline">
                Open in Maps ↗
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Customization Accordion / Controls -->
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xs transition-colors dark:border-slate-800 dark:bg-slate-900 space-y-6">
        <h2 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
